// ========================================================
// 贪心算法构造字典序最小字符串
// ========================================================
// 问题描述：
//   给定一个字符串 s 和一个整数 k，从 s 中删除 k 个字符，
//   使得剩下的字符串的字典序最小。
// 
// 贪心策略：
//   1. 使用栈来维护当前最优解
//   2. 遍历字符串，对于每个字符：
//      - 如果当前字符比栈顶小，且还有删除次数，弹出栈顶
//      - 将当前字符压入栈
//   3. 如果遍历结束后还有删除次数，从尾部删除
// 
// 时间复杂度：O(n)，n 为字符串长度
// 空间复杂度：O(n)，栈的最大长度
// ========================================================

仓 导入 "std";
仓 导入 "collections";

// ========================================================
// 方法一：使用栈实现（推荐）
// ========================================================
函 贪心构造最小字符串(s: 串, 删除次数: 整) -> 串 {
    // 边界情况处理
    若 删除次数 <= 0 {
        返 s;
    }
    
    字符串长度 := s.长度();
    若 删除次数 >= 字符串长度 {
        返 "";
    }
    
    // 使用栈存储结果字符
    结果栈 := 集合.新栈[串]();
    
    // 遍历每个字符
    遍历 (索引, 当前字符) := 枚举(s) {
        // 贪心核心：尽可能删除较大的字符
        // 当栈不为空、还有删除次数、且当前字符更小
        当 结果栈.长度() > 0 
            且 删除次数 > 0 
            且 当前字符 < 结果栈.顶部() {
            
            // 弹出栈顶（相当于删除）
            结果栈.弹出();
            删除次数 -= 1;
        }
        
        // 将当前字符压入栈
        结果栈.压入(当前字符);
    }
    
    // 处理剩余的删除次数（从尾部删除）
    当 删除次数 > 0 {
        结果栈.弹出();
        删除次数 -= 1;
    }
    
    // 将栈转换为字符串（需要反转）
    最终结果 := "";
    当 结果栈.长度() > 0 {
        最终结果 = 结果栈.弹出() + 最终结果;
    }
    
    返 最终结果;
}

// ========================================================
// 方法二：使用数组模拟栈（更高效）
// ========================================================
函 贪心构造最小字符串数组版(s: 串, 删除次数: 整) -> 串 {
    栈 := []串{};
    
    遍历 当前字符 := s {
        // 贪心策略
        当 删除次数 > 0 
            且 栈.长度() > 0 
            且 当前字符 < 栈[栈.长度()-1] {
            
            // 弹出最后一个元素
            栈 = 栈[0:栈.长度()-1];
            删除次数 -= 1;
        }
        
        // 添加当前字符
        栈 = 栈 + [当前字符];
    }
    
    // 处理剩余删除
    若 删除次数 > 0 {
        栈 = 栈[0:栈.长度()-删除次数];
    }
    
    // 连接成字符串
    返 串.连接(栈);
}

// ========================================================
// 辅助函数：测试用例执行
// ========================================================
函 测试用例(输入字符串: 串, 删除数量: 整, 期望结果: 串) {
    实际结果1 := 贪心构造最小字符串(输入字符串, 删除数量);
    实际结果2 := 贪心构造最小字符串数组版(输入字符串, 删除数量);
    
    状态1 := 若 实际结果1 == 期望结果 {"✓"} 否则 {"✗"};
    状态2 := 若 实际结果2 == 期望结果 {"✓"} 否则 {"✗"};
    
    输出("输入: \"" + 输入字符串 + "\", k=" + 串.从整(删除数量));
    输出("期望: \"" + 期望结果 + "\"");
    输出("栈版: \"" + 实际结果1 + "\" [" + 状态1 + "]");
    输出("数组版: \"" + 实际结果2 + "\" [" + 状态2 + "]");
    输出("---");
}

// ========================================================
// 主函数：运行测试用例
// ========================================================
函 主() {
    输出("==========================================");
    输出("贪心算法构造字典序最小字符串");
    输出("==========================================\n");
    
    // 测试用例1：经典示例
    测试用例("1432219", 3, "1219");
    
    // 测试用例2：包含前导零
    测试用例("10200", 1, "0200");
    
    // 测试用例3：递增序列（只能从尾部删除）
    测试用例("abcde", 2, "abc");
    
    // 测试用例4：递减序列（尽可能删除前面的大字符）
    测试用例("54321", 2, "321");
    
    // 测试用例5：需要多次弹出
    测试用例("123456789", 4, "12345");
    
    // 测试用例6：空字符串边界
    测试用例("a", 1, "");
    
    // 测试用例7：k=0（不删除）
    测试用例("hello", 0, "hello");
    
    // 测试用例8：复杂情况
    测试用例("abcabc", 3, "aabc");
    
    输出("==========================================");
    输出("所有测试完成！");
}

// 执行主函数
主();