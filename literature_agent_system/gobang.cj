// ========================================================
// 仓颉语言五子棋游戏
// ========================================================
// 游戏说明：
//   - 10x10 的棋盘空间
//   - 玩家与电脑对弈
//   - 先将5个棋子连成一条线者获胜
//   - 玩家可选择不同的几何图形作为棋子
//
// 支持的棋子形状：
//   1. 三角形 (△)
//   2. 圆形 (○)
//   3. 方形 (□)
//   4. 菱形 (◇)
//   5. 星形 (☆)
//
// ========================================================

导入 "std";
导入 "collections";

// ========================================================
// 常量定义
// ========================================================
常量 棋盘大小 := 10;
常量 获胜长度 := 5;

// 棋子形状枚举
枚举 棋子形状 {
    三角形,
    圆形,
    方形,
    菱形,
    星形
}

// 棋盘格子状态
枚举 格子状态 {
    空,
    玩家,
    电脑
}

// ========================================================
// 棋子结构
// ========================================================
结构 棋子 {
    形状: 棋子形状;
    所有者: 格子状态;
}

// ========================================================
// 游戏状态结构
// ========================================================
结构 游戏状态 {
    棋盘: [[棋子]];
    当前回合: 格子状态;
    游戏结束: 布尔;
    胜利者: 格子状态;
}

// ========================================================
// 获取棋子形状对应的符号
// ========================================================
函 获取形状符号(形状: 棋子形状, 所有者: 格子状态) -> 串 {
    若 所有者 == 格子状态.空 {
        返 "·";
    }
    
    let 前缀 := 若 所有者 == 格子状态.玩家 {"▲"} 否则 {"●"};
    
    匹配 形状 {
        case 棋子形状.三角形 => 返 "△";
        case 棋子形状.圆形 => 返 "○";
        case 棋子形状.方形 => 返 "□";
        case 棋子形状.菱形 => 返 "◇";
        case 棋子形状.星形 => 返 "☆";
        默认 => 返 "○";
    }
}

// ========================================================
// 创建空棋子
// ========================================================
函 新建空棋子() -> 棋子 {
    返 棋子{
        形状: 棋子形状.圆形,
        所有者: 格子状态.空
    };
}

// ========================================================
// 初始化游戏状态
// ========================================================
函 初始化游戏() -> 游戏状态 {
    // 创建空棋盘
    mut 棋盘 := [[棋子]]{};
    
    遍历 i := 0 .. 棋盘大小 {
        mut 行 := [棋子]{};
        遍历 j := 0 .. 棋盘大小 {
            行.追加(新建空棋子());
        }
        棋盘.追加(行);
    }
    
    返 游戏状态{
        棋盘: 棋盘,
        当前回合: 格子状态.玩家,
        游戏结束: 假,
        胜利者: 格子状态.空
    };
}

// ========================================================
// 显示棋盘
// ========================================================
函 显示棋盘(状态: 游戏状态) {
    输出("\n   ");
    
    // 列号
    遍历 i := 0 .. 棋盘大小 {
        输出(" " + 串.从整(i) + " ");
    }
    输出("");
    
    // 棋盘上边框
    输出("  ┌" + "───" * 棋盘大小 + "┐");
    
    // 棋盘内容
    遍历 (行索引, 行) := 枚举(状态.棋盘) {
        // 行号
        输出(" " + 串.从整(行索引) + " │" + " ".重复(棋盘大小 * 3) + "│");
        
        // 棋子行
        mut 棋子行 := "  │";
        遍历 格子 := 行 {
            棋子行 = 棋子行 + 获取形状符号(格子.形状, 格子.所有者) + " ";
        }
        输出(棋子行 + "│");
        
        // 棋盘下边框
        输出("  ├" + "───" * 棋盘大小 + "┤");
    }
    
    // 最底边框
    输出("  └" + "───" * 棋盘大小 + "┘");
}

// ========================================================
// 检查是否在棋盘范围内
// ========================================================
函 在范围内(行: 整, 列: 整) -> 布尔 {
    返 行 >= 0 且 行 < 棋盘大小 且 列 >= 0 且 列 < 棋盘大小;
}

// ========================================================
// 检查四个方向的连续棋子数
// ========================================================
函 检查方向(状态: 游戏状态, 起始行: 整, 起始列: 整, 行增量: 整, 列增量: 整, 玩家: 格子状态) -> 整 {
    mut 计数 := 1;
    mut 当前行 := 起始行 + 行增量;
    mut 当前列 := 起始列 + 列增量;
    
    // 正向检查
    当 在范围内(当前行, 当前列) 且 状态.棋盘[当前行][当前列].所有者 == 玩家 {
        计数 += 1;
        当前行 += 行增量;
        当前列 += 列增量;
    }
    
    // 反向检查
    当前行 = 起始行 - 行增量;
    当前列 = 起始列 - 列增量;
    当 在范围内(当前行, 当前列) 且 状态.棋盘[当前行][当前列].所有者 == 玩家 {
        计数 += 1;
        当前行 -= 行增量;
        当前列 -= 列增量;
    }
    
    返 计数;
}

// ========================================================
// 检查是否获胜
// ========================================================
函 检查获胜(状态: 游戏状态, 行: 整, 列: 整) -> 布尔 {
    let 当前玩家 := 状态.棋盘[行][列].所有者;
    
    // 八个方向：水平、垂直、两条对角线
    let 方向 := [
        [0, 1],   // 水平右
        [1, 0],   // 垂直下
        [1, 1],   // 对角线右下
        [1, -1]   // 对角线左下
    ];
    
    遍历 [行增量, 列增量] := 方向 {
        let 计数 := 检查方向(状态, 行, 列, 行增量, 列增量, 当前玩家);
        若 计数 >= 获胜长度 {
            返 真;
        }
    }
    
    返 假;
}

// ========================================================
// 玩家下棋
// ========================================================
函 玩家下棋(状态: 游戏状态, 形状: 棋子形状, 行: 整, 列: 整) -> 布尔 {
    若 不 在范围内(行, 列) {
        输出("错误：位置超出范围！");
        返 假;
    }
    
    若 状态.棋盘[行][列].所有者 != 格子状态.空 {
        输出("错误：该位置已有棋子！");
        返 假;
    }
    
    // 放置棋子
    状态.棋盘[行][列] = 棋子{
        形状: 形状,
        所有者: 格子状态.玩家
    };
    
    // 检查是否获胜
    若 检查获胜(状态, 行, 列) {
        状态.游戏结束 = 真;
        状态.胜利者 = 格子状态.玩家;
    }
    
    返 真;
}

// ========================================================
// 简单AI：找到最佳位置
// ========================================================
函 电脑下棋(状态: 游戏状态) -> 布尔 {
    // 遍历棋盘找空位
    遍历 (行, 行内容) := 枚举(状态.棋盘) {
        遍历 (列, _) := 枚举(行内容) {
            若 状态.棋盘[行][列].所有者 == 格子状态.空 {
                // 放置临时棋子检查是否能赢
                状态.棋盘[行][列] = 棋子{
                    形状: 棋子形状.星形,
                    所有者: 格子状态.电脑
                };
                
                // 检查电脑是否能赢
                若 检查获胜(状态, 行, 列) {
                    输出("\n电脑选择：(" + 串.从整(行) + ", " + 串.从整(列) + ")");
                    返 真;
                }
                
                // 撤销，检查玩家是否即将赢
                状态.棋盘[行][列] = 棋子{
                    形状: 棋子形状.圆形,
                    所有者: 格子状态.玩家
                };
                
                若 检查获胜(状态, 行, 列) {
                    // 必须阻挡
                    状态.棋盘[行][列] = 棋子{
                        形状: 棋子形状.星形,
                        所有者: 格子状态.电脑
                    };
                    输出("\n电脑选择：(" + 串.从整(行) + ", " + 串.从整(列) + ") [阻挡玩家]>");
                    返 真;
                }
                
                // 撤销
                状态.棋盘[行][列] = 棋子{
                    形状: 棋子形状.圆形,
                    所有者: 格子状态.空
                };
            }
        }
    }
    
    // 如果没有必杀或必挡的选择，选择中心附近的位置
    mut 最佳行 := 棋盘大小 / 2;
    mut 最佳列 := 棋盘大小 / 2;
    mut 最佳距离 := 棋盘大小 * 2;
    
    遍历 (行, 行内容) := 枚举(状态.棋盘) {
        遍历 (列, _) := 枚举(行内容) {
            若 状态.棋盘[行][列].所有者 == 格子状态.空 {
                let 距离 := (行 - 最佳行).绝对值() + (列 - 最佳列).绝对值();
                
                // 优先选择有邻居棋子的位置
                mut 邻居数 := 0;
                遍历 di := -1 .. 2 {
                    遍历 dj := -1 .. 2 {
                        若 不 (di == 0 且 dj == 0) {
                            let ni := 行 + di;
                            let nj := 列 + dj;
                            若 在范围内(ni, nj) 且 状态.棋盘[ni][nj].所有者 != 格子状态.空 {
                                邻居数 += 1;
                            }
                        }
                    }
                }
                
                let 分数 := 邻居数 * 10 - 距离;
                let 最佳分数 := 0;
                
                // 选择分数最高的位置
                若 分数 > 最佳分数 {
                    最佳分数 = 分数;
                    最佳行 = 行;
                    最佳列 = 列;
                }
            }
        }
    }
    
    // 放置AI棋子
    状态.棋盘[最佳行][最佳列] = 棋子{
        形状: 棋子形状.星形,
        所有者: 格子状态.电脑
    };
    
    输出("\n电脑选择：(" + 串.从整(最佳行) + ", " + 串.从整(最佳列) + ")");
    
    // 检查是否获胜
    若 检查获胜(状态, 最佳行, 最佳列) {
        状态.游戏结束 = 真;
        状态.胜利者 = 格子状态.电脑;
    }
    
    返 真;
}

// ========================================================
// 显示棋子选择菜单
// ========================================================
函 显示形状菜单() {
    输出("\n请选择您的棋子形状：");
    输出("1. 三角形 △");
    输出("2. 圆形 ○");
    输出("3. 方形 □");
    输出("4. 菱形 ◇");
    输出("5. 星形 ☆");
    输出("请输入数字 (1-5)：");
}

// ========================================================
// 获取选择的形状
// ========================================================
函 获取选择形状(选择: 整) -> 棋子形状 {
    匹配 选择 {
        case 1 => 返 棋子形状.三角形;
        case 2 => 返 棋子形状.圆形;
        case 3 => 返 棋子形状.方形;
        case 4 => 返 棋子形状.菱形;
        case 5 => 返 棋子形状.星形;
        默认 => 返 棋子形状.圆形;
    }
}

// ========================================================
// 主菜单
// ========================================================
函 显示主菜单() {
    输出("\n");
    输出("╔═══════════════════════════════════════╗");
    输出("║       仓 颉 五 子 棋 游 戏             ║");
    输出("║         Gobang Game                   ║");
    输出("╠═══════════════════════════════════════╣");
    输出("║  棋盘大小：10 x 10                     ║");
    输出("║  获胜条件：连成 5 个棋子                ║");
    输出("║  游戏模式：人机对战                    ║");
    输出("╚═══════════════════════════════════════╝");
}

// ========================================================
// 运行游戏
// ========================================================
函 运行游戏() {
    显示主菜单();
    
    // 选择棋子形状
    显示形状菜单();
    mut 输入 := "";
    
    // 读取玩家输入
    let scanner := 控制台.读取行();
    输入 = scanner;
    
    let 选择 := 串.转整数(输入);
    若 选择 < 1 || 选择 > 5 {
        输出("无效选择，默认使用圆形 ○");
    }
    
    let 玩家形状 := 获取选择形状(选择);
    
    // 初始化游戏
    mut 状态 := 初始化游戏();
    
    输出("\n游戏开始！您使用 " + 获取形状符号(玩家形状, 格子状态.玩家) + "，电脑使用 ☆");
    输出("输入格式：行号 列号（例如：3 5）");
    输出("输入 q 退出游戏\n");
    
    // 游戏主循环
    当 不 状态.游戏结束 {
        显示棋盘(状态);
        
        若 状态.当前回合 == 格子状态.玩家 {
            输出("\n轮到您下棋，请输入位置：");
            
            let 输入行 := 控制台.读取行();
            let parts := 输入行.分割(" ");
            
            若 parts.长度() == 1 且 parts[0] == "q" {
                输出("游戏已退出！");
                跳出;
            }
            
            若 parts.长度() != 2 {
                输出("错误：请输入两个数字（行号 列号）！");
                继续;
            }
            
            let 行 := 串.转整数(parts[0]);
            let 列 := 串.转整数(parts[1]);
            
            若 行 < 0 || 行 >= 棋盘大小 || 列 < 0 || 列 >= 棋盘大小 {
                输出("错误：位置超出范围！请输入 0-" + 串.从整(棋盘大小 - 1) + " 之间的数字！");
                继续;
            }
            
            若 不 玩家下棋(状态, 玩家形状, 行, 列) {
                继续;
            }
            
            若 状态.游戏结束 {
                状态.当前回合 = 格子状态.空;
            } 否则 {
                状态.当前回合 = 格子状态.电脑;
            }
        } 否则 {
            // 电脑回合
            输出("\n电脑思考中...");
            电脑下棋(状态);
            
            若 状态.游戏结束 {
                状态.当前回合 = 格子状态.空;
            } 否则 {
                状态.当前回合 = 格子状态.玩家;
            }
        }
    }
    
    // 显示最终棋盘
    显示棋盘(状态);
    
    // 显示游戏结果
    输出("\n");
    输出("═══════════════════════════════════════");
    
    匹配 状态.胜利者 {
        case 格子状态.玩家 =>
            输出("  恭喜您！您获得了胜利！  🎉");
        case 格子状态.电脑 =>
            输出("  很遗憾，电脑获胜了！  😢");
        默认 =>
            输出("  游戏结束！");
    }
    
    输出("═══════════════════════════════════════\n");
}

// ========================================================
// 主函数入口
// ========================================================
函 主() {
    运行游戏();
}

// ========================================================
// 程序入口点
// ========================================================
主();